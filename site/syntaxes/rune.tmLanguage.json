{
  "fileTypes": [
    "rn"
  ],
  "foldingStartMarker": "^.*\\bfn\\s*(\\w+\\s*)?\\([^\\)]*\\)(\\s*\\{[^\\}]*)?\\s*$",
  "foldingStopMarker": "^\\s*\\}",
  "name": "Rune",
  "patterns": [
    {
      "match": "'[a-zA-Z_][a-zA-Z0-9_]*(?=[^\\'])",
      "name": "variable.other.source.rune"
    },
    {
      "begin": "'",
      "end": "'",
      "name": "string.quoted.single.source.rune",
      "patterns": [
        {
          "include": "#rune_escaped_character"
        }
      ]
    },
    {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.source.rune",
      "patterns": [
        {
          "include": "#rune_escaped_character"
        }
      ]
    },
    {
      "begin": "`",
      "end": "`",
      "name": "string.quoted.double.source.rune",
      "patterns": [
        {
          "include": "#rune_escaped_character"
        }
      ]
    },
    {
      "captures": {
        "1": {
          "name": "keyword.source.rune"
        },
        "2": {
          "name": "entity.name.function.source.rune"
        },
        "3": {
          "name": "keyword.operator.rune"
        }
      },
      "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]?[\\w\\:,+ \\'<>]*)\\s*(\\()",
      "name": "meta.function.source.rune"
    },
    {
      "match": "\\b(as|break|claim|const|copy|Copy|do|drop|else|extern|for|if|impl|in|let|loop|match|mod|mut|Owned|priv|pub|pure|ref|return|unsafe|use|while|mod|Send|static|trait|struct|enum|type)\\b",
      "name": "keyword.source.rune"
    },
    {
      "match": "\\b(Self|int|float|unit|char|bool|String|Bytes|GeneratorState|Generator|Future|Option|Result)\\b",
      "name": "storage.type.source.rune"
    },
    {
      "match": "\\bself\\b",
      "name": "variable.language.source.rune"
    },
    {
      "match": "\\b(true|false|Some|None|Left|Right|Ok|Err)\\b",
      "name": "constant.language.source.rune"
    },
    {
      "match": "\\b(EXIT_FAILURE|EXIT_SUCCESS|RAND_MAX|EOF|SEEK_SET|SEEK_CUR|SEEK_END|_IOFBF|_IONBF|_IOLBF|BUFSIZ|FOPEN_MAX|FILENAME_MAX|L_tmpnam|TMP_MAX|O_RDONLY|O_WRONLY|O_RDWR|O_APPEND|O_CREAT|O_EXCL|O_TRUNC|S_IFIFO|S_IFCHR|S_IFBLK|S_IFDIR|S_IFREG|S_IFMT|S_IEXEC|S_IWRITE|S_IREAD|S_IRWXU|S_IXUSR|S_IWUSR|S_IRUSR|F_OK|R_OK|W_OK|X_OK|STDIN_FILENO|STDOUT_FILENO|STDERR_FILENO)\\b",
      "name": "support.constant.source.rune"
    },
    {
      "match": "^(\\w\\(\\w\\)*!)|(#\\[[\\w=\\(\\)_]+\\])$",
      "name": "comment.block.preprocessor.rune"
    },
    {
      "match": "\\{|\\}",
      "name": "keyword.operator.rune"
    },
    {
      "match": "\\(|\\)",
      "name": "keyword.operator.rune"
    },
    {
      "match": "\\[|\\]",
      "name": "keyword.operator.rune"
    },
    {
      "match": "\\b(([0-9][0-9_]*)|([0-9][0-9_]*(u|u8|u16|u32|u64))|([0-9][0-9_]*))\\b",
      "name": "constant.numeric.integer.source.rune"
    },
    {
      "match": "\\b((0x[a-fA-F0-9_]+)|(0x[a-fA-F0-9_]+(u|u8|u16|u32|u64))|(0x[a-fA-F0-9_]+))\\b",
      "name": "constant.numeric.hex.source.rune"
    },
    {
      "match": "\\b((0b[01_]+)|(0b[01_]+(u|u8|u16|u32|u64))|(0b[01_]+))\\b",
      "name": "constant.numeric.binary.source.rune"
    },
    {
      "match": "([0-9][0-9_]*(f32|f64|f))|([0-9][0-9_]*([eE][+-]=[0-9_]+))|([0-9][0-9_]*([eE][+-]=[0-9_]+)(f32|f64|f))|([0-9][0-9_]*\\.[0-9_]+)|([0-9][0-9_]*\\.[0-9_]+(f32|f64|f))|([0-9][0-9_]*\\.[0-9_]+%([eE][+-]=[0-9_]+))|([0-9][0-9_]*\\.[0-9_]+%([eE][+-]=[0-9_]+)(f32|f64|f))",
      "name": "constant.numeric.float.source.rune"
    },
    {
      "begin": "//!",
      "end": "$\\n",
      "name": "comment.line.documentation.source.rune"
    },
    {
      "begin": "//",
      "end": "$\\n",
      "name": "comment.line.double-dash.source.rune"
    },
    {
      "begin": "/\\*",
      "end": "\\*/",
      "name": "comment.block.source.rune"
    },
    {
      "match": "(=>)|(->)|[-:=*,!.+|%/&~@<>;]",
      "name": "keyword.operator.rune"
    },
    {
      "match": "_",
      "name": "support.function.rune"
    }
  ],
  "repository": {
    "rune_escaped_character": {
      "match": "\\\\(x\\h{2}|[0-2][0-7]{,2}|3[0-6][0-7]?|37[0-7]?|[4-7][0-7]?|.)",
      "name": "constant.character.escape.source.rune"
